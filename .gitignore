!models/road_damage/5epoch_run/best.pt
!models/road_damage/5epoch_run/training_metrics.json
!models/road_damage/5epoch_run/class_mapping.json

# Datasets & Heavy Computer Vision Archives
# 1. Official CO2 Emissions Canada (fully tracked for immediate reproducibility)
!dataset/raw/emissions/**
!dataset/processed/emissions/**

# 2. RDD2022 India Heavy Data (502 MB archive + 32,000 raw/processed images excluded to comply with GitHub limits)
# Regenerable via: python ml/download_rdd2022.py && python ml/preprocess_rdd2022.py
dataset/raw/rdd2022/**/*.zip
dataset/raw/rdd2022/**/*.tar*
dataset/raw/rdd2022/India/
dataset/processed/road_damage/images/train/
dataset/processed/road_damage/images/val/
dataset/processed/road_damage/images/test/*.jpg
!dataset/processed/road_damage/images/test/India_000168.jpg
!dataset/processed/road_damage/images/test/India_000174.jpg
!dataset/processed/road_damage/images/test/India_000241.jpg
