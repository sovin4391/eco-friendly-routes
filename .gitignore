# Machine Learning Models & Serialized Artifacts (Tracked via Git LFS in .gitattributes)
# Intermediate and redundant training runs are ignored
runs/
yolov8*.pt
models/**/last.pt
models/**/epoch*.pt
models/**/results.csv
models/road_damage/corrected_run/
!models/.gitkeep
!models/README.md
!models/model_metadata.json
!models/emissions_model.joblib
!models/road_damage/best.pt
!models/road_damage/training_metrics.json
!models/road_damage/class_mapping.json
!models/road_damage/baseline/best.pt
!models/road_damage/baseline/training_metrics.json
!models/road_damage/baseline/class_mapping.json
